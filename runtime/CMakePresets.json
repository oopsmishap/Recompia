{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (Apple Silicon, Release)",
      "description": "The runtime, the game modules and the graphics shell for Apple Silicon. Vulkan comes from MoltenVK (cmake/gfx_deps.cmake); the launcher, Media Foundation movies and the XAudio2 sink are Windows-only and are not built.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "NXRT_BUILD_GFX": "ON",
        "NXRT_BUILD_GAMES": "ON",
        "NXRT_GAMES": "pkp"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 (Apple Silicon, Debug)",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" }
  ]
}
